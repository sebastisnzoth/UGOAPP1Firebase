rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Validación de la cuenta raíz del propietario del sistema
    function esSoberano() {
      return request.auth != null && request.auth.token.email == 'sebastianzoth@gmail.com';
    }
    // El usuario está habilitado para operar servicios si su Karma es superior al umbral crítico
    function cuentaActiva() {
      let user = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
      return user != null && user.karma >= 40;
    }
    // Perfiles de Usuarios (Clientes y Proveedores)
    match /profiles/{userId} {
      // Allow read if authenticated or if it's a guest, or if it's to fetch providers
      allow read: if true; 
      allow write: if request.auth != null && (request.auth.uid == userId || esSoberano()) || userId == 'guest_user';
    }
    // Colección de Logs de Auditoría y Conversaciones en vivo con Hugo
    match /comunicaciones/{document=**} {
      allow read, write: if request.auth != null || esSoberano() || request.auth == null;
    }
    // Directorio de Ubicación en Tiempo Real (Modo Uber)
    match /profiles_providers/{document=**} {
      allow read: if true;
      allow write: if esSoberano() || request.auth != null;
    }
    // Reservas de Servicios y Bóveda Escrow
    match /bookings/{bookingId} {
      allow create: if request.auth != null || request.auth == null;
      allow read, update: if request.auth != null || request.auth == null;
    }
  }
}