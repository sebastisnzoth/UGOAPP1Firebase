rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function esSoberano() {
      return signedIn() && request.auth.token.get('email', '') == 'sebastianzoth@gmail.com';
    }

    function cuentaActiva() {
      let userPath = /databases/$(database)/documents/profiles/$(request.auth.uid);
      return signedIn() && (!exists(userPath) || get(userPath).data.get('karma', 100) >= 40);
    }

    function esProveedor(userId) {
      let userPath = /databases/$(database)/documents/profiles/$(userId);
      return exists(userPath) && get(userPath).data.get('role', '') == 'proveedor';
    }

    function isParticipant(data) {
      return signedIn() && (
        data.get('clienteId', '') == request.auth.uid
        || data.get('clientId', '') == request.auth.uid
        || data.get('proveedorId', '') == request.auth.uid
        || data.get('providerId', '') == request.auth.uid
      );
    }

    match /profiles/{userId} {
      allow read: if true;

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['cliente', 'proveedor'];

      allow update: if esSoberano() || (
        isOwner(userId)
        && cuentaActiva()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['karma', 'email'])
        && (
          request.resource.data.role == resource.data.get('role', '')
          || (resource.data.get('role', '') == '' && request.resource.data.role in ['cliente', 'proveedor'])
        )
      );

      allow delete: if esSoberano() || isOwner(userId);
    }

    match /profiles_providers/{providerId} {
      allow read: if true;
      allow write: if esSoberano() || (isOwner(providerId) && esProveedor(providerId) && cuentaActiva());
    }

    match /bookings/{bookingId} {
      allow create: if esSoberano() || (cuentaActiva() && isParticipant(request.resource.data));
      allow read, update: if esSoberano() || (cuentaActiva() && isParticipant(resource.data));
      allow delete: if esSoberano();
    }

    match /contratos/{contratoId} {
      allow create: if esSoberano() || (cuentaActiva() && isParticipant(request.resource.data));
      allow read, update: if esSoberano() || (cuentaActiva() && isParticipant(resource.data));
      allow delete: if esSoberano();
    }

    match /comunicaciones/{messageId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if esSoberano() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if esSoberano();
    }

    match /logs_hugo/{logId} {
      allow create: if signedIn() && request.resource.data.usuario_id == request.auth.uid;
      allow read: if esSoberano() || (signedIn() && resource.data.usuario_id == request.auth.uid);
      allow update, delete: if esSoberano();
    }

    match /mensagens/{messageId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update, delete: if false;
    }

    match /avaliacoes/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if esSoberano();
    }

    match /agendamentos/{appointmentId} {
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow read, update: if esSoberano() || (signedIn() && (resource.data.clientId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow delete: if esSoberano();
    }

    match /notifications/{notificationId} {
      allow create: if esSoberano();
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if esSoberano();
    }

    match /wallets/{userId} {
      allow read, create: if isOwner(userId);
      allow update, delete: if esSoberano();
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if esSoberano();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
