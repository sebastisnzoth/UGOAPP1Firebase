rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funciones de validación
    function esSoberano() {
      return request.auth != null && request.auth.token.email == 'sebastianzoth@gmail.com';
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /profiles/{userId} {
      allow read, write: if true;
    }

    // Comms y Proveedores
    match /comunicaciones/{document=**} {
      allow read, write: if true;
    }
    match /profiles_providers/{document=**} {
      allow read, write: if true;
    }
  }
}
